# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and nested packages — never commit installs)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# secrets — never commit environment files
.env
.env.*
!.env.example
backend/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Mātai Manapori response cache (not source data)
.cache/
.venv-minutes/
