# Beehive v1, the Next.js site, does not need any environment variables.
# The legacy Express API in backend/ is not part of the website.
# If you run that old service yourself, use placeholders. Do not commit real secrets.

NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beehive
DB_USER=beehive
DB_PASSWORD=change-me
JWT_SECRET=change-me
